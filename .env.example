# Copy this file to .env and fill in ONE AI key.
# Never commit .env — it is gitignored.
#
# Jarvis auto-detects the provider from whichever key you set.
# Built-in tools (weather, time, research, chat, memory, automations, computer/browser) do not need extra keys.
# Mail and calendar need Google OAuth (not a second AI key): python main.py --connect google

# Pick one:
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Or a single generic key plus an explicit provider:
# JARVIS_API_KEY=
# JARVIS_LLM_PROVIDER=gemini
# JARVIS_MODEL=

# Optional: print LLM prompts (default off)
# JARVIS_DEBUG=1

# Optional MCP config (Claude Desktop format). Built-in tools still need no extra keys.
# Default search: ./mcp.json then ~/.jarvis/mcp.json
# JARVIS_MCP_CONFIG=/path/to/mcp.json

# Optional persistent memory / automation / auth locations (default: ~/.jarvis/)
# JARVIS_HOME=~/.jarvis
# JARVIS_MEMORY_PATH=~/.jarvis/memory.json
# JARVIS_AUTOMATIONS_PATH=~/.jarvis/automations.json
# JARVIS_AUTH_PATH=~/.jarvis/auth.json

# Optional Google OAuth for mail + calendar (not an AI key).
# Create a Desktop OAuth client, enable Gmail API + Calendar API, then:
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# Run: python main.py --connect google

# Copy this file to .env and fill in ONE AI key.
# Never commit .env — it is gitignored.
#
# Jarvis auto-detects the provider from whichever key you set.
# Built-in tools (weather, time, research) do not need extra keys.

# Pick one:
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Or a single generic key plus an explicit provider:
# JARVIS_API_KEY=
# JARVIS_LLM_PROVIDER=gemini
# JARVIS_MODEL=

# Optional: print LLM prompts (default off)
# JARVIS_DEBUG=1
